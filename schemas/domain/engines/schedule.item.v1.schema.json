{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homi.local/schemas/domain/engines/schedule.item.v1.schema.json",
  "title": "Homi v1 ScheduleItemV1",
  "type": "object",
  "required": [
    "title"
  ],
  "additionalProperties": true,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "repeat": {
      "type": "string",
      "enum": [
        "daily",
        "yearly"
      ]
    },
    "monthDay": {
      "type": "string",
      "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "timeStart": {
      "type": "string",
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
    },
    "timeEnd": {
      "type": "string",
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
    },
    "notes": {
      "type": "string",
      "maxLength": 10000
    },
    "tags": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "repeatIntervalSec": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "repeat": {
            "const": "daily"
          }
        },
        "required": [
          "repeat"
        ]
      },
      "then": {
        "required": [
          "timeStart"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "repeat": {
            "const": "yearly"
          }
        },
        "required": [
          "repeat"
        ]
      },
      "then": {
        "required": [
          "monthDay",
          "timeStart"
        ]
      }
    }
  ]
}
